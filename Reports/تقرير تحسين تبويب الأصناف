function switchItemTab(tab) {
    ['basic', 'units', 'advanced'].forEach(t => {
        document.getElementById('item-panel-' + t).classList.add('hidden');
        document.getElementById('item-tab-' + t).classList.remove('bg-blue-600', 'text-white');
        document.getElementById('item-tab-' + t).classList.add('text-gray-500');
    });
    document.getElementById('item-panel-' + tab).classList.remove('hidden');
    document.getElementById('item-tab-' + tab).classList.add('bg-blue-600', 'text-white');
    document.getElementById('item-tab-' + tab).classList.remove('text-gray-500');
}

function onMeasureTypeChange() {
    const type = document.getElementById('item-measure-type').value;
    const baseSelect = document.getElementById('item-base-unit');
    let options = '';
    if (type === 'COUNT') {
        options = `<option value="PCS">قطعة</option><option value="BOX">علبة</option><option value="CTN">كرتونة</option>`;
    } else if (type === 'WEIGHT') {
        options = `<option value="KG">كيلوجرام</option><option value="G">جرام</option>`;
    } else if (type === 'VOLUME') {
        options = `<option value="L">لتر</option><option value="ML">مليلتر</option>`;
    }
    baseSelect.innerHTML = options;
}

function addAltUnitRow(unitName = '', factor = '', barcode = '') {
    const tbody = document.getElementById('alt-units-body');
    const row = document.createElement('tr');
    row.innerHTML = `
        <td class="py-2 pl-2"><input type="text" class="alt-name w-full rounded-lg border p-2 text-sm" value="${unitName}" placeholder="مثال: كرتونة"></td>
        <td class="py-2 pl-2"><input type="number" class="alt-factor w-full rounded-lg border p-2 text-sm" value="${factor}" placeholder="مثال: 12"></td>
        <td class="py-2 pl-2"><input type="text" class="alt-barcode w-full rounded-lg border p-2 text-sm font-mono" value="${barcode}" placeholder="باركود الوحدة"></td>
        <td class="py-2 text-center"><button onclick="this.closest('tr').remove()" class="text-rose-500 hover:text-rose-700">✕</button></td>
    `;
    tbody.appendChild(row);
}

function generateInternalBarcode() {
    // توليد باركود داخلي بادئة 20 (GS1)
    const prefix = '20';
    const random = Math.floor(1000000000 + Math.random() * 9000000000).toString();
    document.getElementById('item-barcode').value = prefix + random;
}

